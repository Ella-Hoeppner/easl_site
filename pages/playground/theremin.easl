; Theremin: sound from the mouse
; A sine wave whose pitch follows the mouse's height over the canvas. The
; audio thread reads `pitch` and `volume`, which the frame loop writes; easl
; shares them between the threads. Click the canvas first: browsers only
; play sound after a click.
(var pitch: f32)

(var volume: f32)

; An oscillator that glides toward `pitch` and `volume`, so the sound
; doesn't click when they jump.
(defn create-oscillator []: (Fn [] f32)
  (let [@var phase 0.
        @var current-pitch 220.
        @var current-volume 0.]
    (fn []
      (+= current-pitch
          (* 0.002 (- pitch current-pitch)))
      (+= current-volume
          (* 0.002
             (- volume current-volume)))
      (= phase
         (fract (+ phase
                   (/ current-pitch (sample-rate)))))
      (* current-volume
         (sin (* 6.28318 phase))))))

(defn vert []: vec4f
  ([(vec4f -1. -1. 0. 1.)
    (vec4f -1. 3. 0. 1.)
    (vec4f 3. -1. 0. 1.)]
   (vertex-index)))

; The wave, drawn across the canvas at the current pitch.
(defn frag []: vec4f
  (let [resolution (vec2f (window-resolution))
        uv (/ (.xy (position)) resolution)
        cycles (/ pitch 110.)
        wave (* 0.35
                (sin (* 6.28318
                        (+ (* uv.x cycles) (window-time)))))
        offset (abs (- (- uv.y 0.5) wave))
        glow (/ (* 0.004 (+ 0.2 (* 3. volume)))
                (+ offset 0.002))]
    (vec4f (* glow (vec3f 0.6 0.5 1.))
           1.)))

@cpu
(defn main []
  (start-audio (create-oscillator))
  (spawn-window
    (fn []
      (let [height (/ (f32 (.y (mouse-coords)))
                      (f32 (.y (window-resolution))))]
        ; two octaves, from 880 Hz at the top to 220 Hz at the bottom
        (= pitch
           (* 220.
              (exp2 (* 2. (- 1. height)))))
        (= volume
           (if (mouse-present?)
             0.25
             0.)))
      (dispatch-render-shaders vert frag 3))))
