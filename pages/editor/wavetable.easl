; wavetable synth with an editable wavetable - try clicking on the canvas!
(var wavetable: [f32])

(defn sample-wavetable [x: f32]: f32
  (if (< x 0.)
    (wavetable 0u)
    (if (>= x 1.)
      (wavetable (- (array-length wavetable) 1))
      (let [i (* x
                 (f32 (array-length wavetable)))
            index (i32 (floor i))]
        (mix (wavetable (u32 (floor i)))
             (wavetable (min (- (array-length wavetable) 1)
                             (u32 (ceil i))))
             (% i 1.))))))

@cpu
(defn main []
  (= wavetable (zeroed-array 50))
  (for [i (array-length wavetable)]
    (= (wavetable i)
       (-> (/ (f32 i)
              (f32 (array-length wavetable)))
           (* 6.28318530718)
           cos
           (+ 1)
           (* 0.5))))
  (start-audio (fn []
                 (-> (audio-time 1.)
                     (* 100)
                     (% 1.)
                     sample-wavetable)))
  (spawn-window (fn []
                  (when (mouse-down?)
                    (let [pos (/ (vec2f (mouse-coords))
                                 (vec2f (window-resolution)))]
                      (= (wavetable (u32 (* pos.x
                                            (f32 (array-length wavetable)))))
                         pos.y)))
                  (dispatch-render-shaders
                    (fn []
                      (match (vertex-index)
                        0u (vec4f -1. -1. 0. 1.)
                        1u (vec4f -1. 3. 0. 1.)
                        _ (vec4f 3. -1. 0. 1.)))
                    (fn []
                      (let [pos (/ (.xy (position))
                                   (vec2f (window-resolution)))]
                        (if (< (sample-wavetable pos.x)
                               pos.y)
                          (vec4f 1.)
                          (vec4f 0. 0. 0. 1.))))
                    3))))
